<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_cube">
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>2.08e-5</ixx><iyy>2.08e-5</iyy><izz>2.08e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <surface>
          <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="body">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <!-- Thin plane on the top face that shows the marker image -->
      <visual name="marker">
        <pose>0 0 0.0251 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>0.05 0.05</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://aruco_cube/materials/textures/marker_0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>