<?xml version="1.0"?>
<sdf version="1.9">
  <model name="place_shelf">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.15 0.15 0.10</size></box></geometry>
      </collision>

      <visual name="body">
        <geometry><box><size>0.15 0.15 0.10</size></box></geometry>
        <material>
          <ambient>0.3 0.45 0.7 1</ambient>
          <diffuse>0.3 0.45 0.7 1</diffuse>
        </material>
      </visual>

      <!-- Marker 1 on the top face: the cube must be placed exactly here -->
      <visual name="marker">
        <pose>0 0 0.0501 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>0.05 0.05</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://place_shelf/materials/textures/marker_1.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
        <!-- Publish the true pose of this model on /model/place_shelf/pose (for benchmarking) -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>10</update_frequency>
    </plugin>
    
  </model>
</sdf>